#!/usr/bin/env bash
# Started by D-Bus activation in place of /opt/teamviewer/tv_bin/TeamViewer_Desktop
# (see share/com.teamviewer.TeamViewer.Desktop.service.in).
#
# teamviewerd asks the user bus for com.teamviewer.TeamViewer.Desktop on every
# incoming connection. On Hyprland that helper needs two things it doesn't get
# by default:
#   1. "wlroots" in XDG_CURRENT_DESKTOP. Otherwise it uses the RemoteDesktop
#      portal, which xdg-desktop-portal-hyprland does not implement.
#   2. Monitor scale 1. Its wlroots screencopy backend rejects every frame whose
#      pixel size differs from the monitor's logical (scaled) size.
# While the helper runs, each scaled monitor switches to scale 1 at the
# resolution that keeps its layout (3840x2160 at 1.25 -> 3072x1728, at 2 ->
# 1920x1080), so everything stays the same size. A monitor that goes back to its
# scale mid-session is switched again, and a display that is off (as it is on a
# locked screen) is turned on first. Modes are restored when the helper exits.
# Run with --restore to put saved modes back by hand.
#
# teamviewerd retries a few seconds apart, so a new helper can start while an
# older one is still running. The older one is ended first, since it holds
# TeamViewer's lock, and only the last wrapper to exit restores the modes.

set -uo pipefail

TV_DESKTOP=/opt/teamviewer/tv_bin/TeamViewer_Desktop
STATE_FILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omarchy-teamviewer-scales.json"
LOCK_FILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omarchy-teamviewer-desktop.lock"

log() {
  echo "omarchy-teamviewer-desktop: $*" >&2
}

can_drive_hyprland() {
  command -v hyprctl >/dev/null && command -v jq >/dev/null && [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]
}

# Omarchy configures Hyprland in Lua, where monitors change through hl.monitor;
# older installs use hyprland.conf, where the same change is a monitor keyword.
lua_config() {
  [[ -f ${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.lua ]]
}

set_monitor() {
  local name=$1 mode=$2 position=$3 scale=$4 transform=$5

  # The name is spliced into Lua source or a keyword line, so only let plain
  # connector names through.
  if [[ ! $name =~ ^[A-Za-z0-9._-]+$ ]]; then
    log "skipping monitor with unexpected name: $name"
    return 1
  fi

  if lua_config; then
    hyprctl eval "hl.monitor({ output = \"$name\", mode = \"$mode\", position = \"$position\", scale = $scale, transform = $transform })" >/dev/null
  else
    hyprctl keyword monitor "$name,$mode,$position,$scale,transform,$transform" >/dev/null
  fi
}

# Turns every display on or off, the way Omarchy's lock does.
set_dpms() {
  if lua_config; then
    hyprctl dispatch "hl.dsp.dpms({ action = \"$([[ $1 == on ]] && echo enable || echo disable)\" })" >/dev/null
  else
    hyprctl dispatch dpms "$1" >/dev/null
  fi
}

current_size() {
  hyprctl -j monitors | jq -r --arg name "$1" '.[] | select(.name == $name) | "\(.width)x\(.height)"'
}

current_state() {
  hyprctl -j monitors | jq -r --arg name "$1" '.[] | select(.name == $name) | "\(.width)x\(.height) at scale \(.scale)"'
}

# For every scaled monitor prints: name, logical size, a listed mode of exactly
# that size (or "-"), the same size as a custom mode, and the closest listed mode
# with the same aspect ratio to fall back on.
plan_modes() {
  jq -r '
    def abs: if . < 0 then -. else . end;
    def modes: [.availableModes[]
      | capture("^(?<w>[0-9]+)x(?<h>[0-9]+)@(?<r>[0-9.]+)Hz$")
      | {w: (.w | tonumber), h: (.h | tonumber), r: (.r | tonumber)}];
    .[] | select(.scale != 1)
    | (.width / .scale | round) as $tw
    | (.height / .scale | round) as $th
    | .refreshRate as $rate
    | (.width / .height) as $aspect
    | modes as $modes
    | ($modes | map(select(.w == $tw and .h == $th)) | min_by(.r - $rate | abs)) as $exact
    | ($modes | map(select((.w / .h) - $aspect | abs < 0.01))) as $same_aspect
    | ((if ($same_aspect | length) > 0 then $same_aspect else $modes end)
        | min_by([(.w - $tw | abs), -.w, (.r - $rate | abs)])) as $nearest
    | [.name,
       "\($tw)x\($th)",
       (if $exact then "\($exact.w)x\($exact.h)@\($exact.r)" else "-" end),
       "\($tw)x\($th)@\($rate | round)",
       (if $nearest then "\($nearest.w)x\($nearest.h)@\($nearest.r)" else "preferred" end),
       .transform]
    | @tsv'
}

switch_to_logical_resolution() {
  local monitors saved='[]'
  monitors=$(hyprctl -j monitors) || return
  jq -e 'any(.[]; .scale != 1)' <<<"$monitors" >/dev/null || return 0

  # Save each monitor's mode before its first switch. A state file left by a run
  # that never restored holds the real originals, and so does the entry of a
  # monitor that went back to its scale mid-session, so only add new monitors.
  [[ -s $STATE_FILE ]] && saved=$(<"$STATE_FILE")
  jq -c --argjson saved "$saved" '$saved + [.[] | select(.scale != 1)
    | select(.name as $name | $saved | all(.name != $name)) | {
      name,
      mode: "\(.width)x\(.height)@\(.refreshRate)",
      position: "\(.x)x\(.y)",
      scale,
      transform
    }]' <<<"$monitors" >"$STATE_FILE.new" && mv "$STATE_FILE.new" "$STATE_FILE" || return

  # Hyprland accepts a new mode for a display that is off, but applies it only
  # when the display comes back on. Omarchy's lock turns displays off a few
  # seconds after locking, and until they're on TeamViewer rejects every frame.
  if jq -e 'any(.[]; .scale != 1 and .dpmsStatus == false)' <<<"$monitors" >/dev/null; then
    set_dpms on
    log "turned the displays on for TeamViewer (they were off, as on a locked screen)"
  fi

  plan_modes <<<"$monitors" |
    while IFS=$'\t' read -r name size exact custom nearest transform; do
      if [[ $exact != - ]]; then
        set_monitor "$name" "$exact" auto 1 "$transform"
      else
        # Drivers and monitors often refuse modes the monitor doesn't list; then
        # Hyprland falls back on its own, so only step in if it picked badly.
        set_monitor "$name" "$custom" auto 1 "$transform"
        if [[ $(current_size "$name") != "$size" && $(current_size "$name") != "${nearest%@*}" ]]; then
          set_monitor "$name" "$nearest" auto 1 "$transform"
        fi
      fi
      state=$(current_state "$name")
      if [[ $state == *" at scale 1" ]]; then
        log "$name: $state for TeamViewer (logical size $size)"
      else
        log "$name: still $state, switching again while TeamViewer runs"
      fi
    done
}

# Anything that sets a monitor up again puts its own scale back: a hotplug, a
# config reload, a display that stayed off. Check every two seconds while the
# helper runs. Only changes are logged, so a monitor that won't switch doesn't
# fill the journal.
keep_scale_one() {
  local child=$1 last="" out
  while sleep 2 && kill -0 "$child" 2>/dev/null; do
    out=$(switch_to_logical_resolution 2>&1)
    [[ -n $out && $out != "$last" ]] && printf '%s\n' "$out" >&2
    last=$out
  done
}

# teamviewerd starts a helper only once it has given up on the previous one, but
# that one can still be running: shutting down, or stuck for good after a
# session in which its screen capture got no frames. It holds TeamViewer's lock
# in $XDG_RUNTIME_DIR, so the new helper would quit after a few seconds, and so
# would every one after it. A stuck helper ignores SIGTERM.
end_stale_helpers() {
  local pids _
  mapfile -t pids < <(pgrep -u "$UID" -f "^$TV_DESKTOP")
  ((${#pids[@]})) || return 0
  log "ending TeamViewer helper ${pids[*]} left from an earlier session"
  kill -TERM "${pids[@]}" 2>/dev/null
  for _ in 1 2 3 4 5 6; do
    sleep 0.5
    pgrep -u "$UID" -f "^$TV_DESKTOP" >/dev/null || return 0
  done
  log "helper ${pids[*]} ignored SIGTERM, killing it"
  kill -KILL "${pids[@]}" 2>/dev/null
}

# Runs once the helper has exited. The keeper notices within two seconds; wait
# for it so it can't switch a monitor again after the restore.
end_session() {
  [[ -n ${keeper:-} ]] && wait "$keeper"
  # A newer helper may already be running. Restoring now would change the mode
  # under it and, on a locked screen, turn its displays off; its wrapper holds
  # the lock too and restores the modes when it's done.
  if $have_lock && ! flock -xn 9; then
    log "another TeamViewer helper is running; leaving the displays to it"
    return
  fi
  restore_scales
  # The displays may have been turned on for the session. A locked screen turns
  # them off only after the next key press, so do it now.
  if command -v omarchy-hyprland-session-locked >/dev/null && omarchy-hyprland-session-locked; then
    set_dpms off
    log "turned the displays off again (the screen is locked)"
  fi
}

restore_scales() {
  [[ -s $STATE_FILE ]] || return 0

  jq -r '.[] | [.name, .mode, .position, .scale, .transform] | @tsv' "$STATE_FILE" |
    while IFS=$'\t' read -r name mode position scale transform; do
      set_monitor "$name" "$mode" "$position" "$scale" "$transform" && log "$name: $mode at scale $scale restored"
    done
  rm -f "$STATE_FILE"
}

if [[ ${1:-} == --restore ]]; then
  can_drive_hyprland || { log "needs hyprctl, jq and a running Hyprland session"; exit 1; }
  restore_scales
  exit
fi

# Every wrapper holds this lock shared while its helper runs and takes it
# exclusively to restore. So a new wrapper waits for a restore in progress
# before it switches, and ending a stale helper below doesn't make that
# helper's wrapper restore the modes under the new one.
have_lock=false
if exec 9>>"$LOCK_FILE" && flock -s -w 10 9; then
  have_lock=true
else
  log "could not lock $LOCK_FILE; the modes are restored when this helper exits, even if another one runs"
fi
end_stale_helpers

case ":${XDG_CURRENT_DESKTOP:-}:" in
*:wlroots:*) ;;
*) export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:+$XDG_CURRENT_DESKTOP:}wlroots" ;;
esac

drive_hyprland=false
if can_drive_hyprland; then
  drive_hyprland=true
  switch_to_logical_resolution
  trap end_session EXIT
else
  log "hyprctl, jq or HYPRLAND_INSTANCE_SIGNATURE missing; leaving monitor scales alone"
fi

# The helper doesn't get the lock: one stuck after its wrapper is gone would
# keep every later wrapper from restoring.
"$TV_DESKTOP" "$@" 9>&- &
child=$!
if $drive_hyprland; then
  keep_scale_one "$child" &
  keeper=$!
fi
trap 'kill -TERM "$child" 2>/dev/null' TERM INT HUP

# wait returns early whenever a trapped signal arrives, so keep waiting until
# the helper is really gone before the EXIT trap restores the scales.
status=0
while kill -0 "$child" 2>/dev/null; do
  wait "$child"
  status=$?
done
exit "$status"
