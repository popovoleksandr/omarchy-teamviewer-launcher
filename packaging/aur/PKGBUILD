pkgname=omarchy-teamviewer-launcher
pkgver=1.0.3
pkgrel=1
pkgdesc="Makes incoming TeamViewer connections work on Omarchy's uwsm-managed Hyprland desktop"
arch=(any)
url="https://github.com/popovoleksandr/omarchy-teamviewer-launcher"
license=(MIT)
depends=(bash dbus jq teamviewer)
install=omarchy-teamviewer-launcher.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('49998457d1b782084a519efb82c112966096179ba41f44cc199a91aa5cb374f5')

package() {
  cd "$pkgname-$pkgver"
  make DESTDIR="$pkgdir" PREFIX=/usr install
}
